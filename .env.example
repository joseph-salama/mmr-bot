GUILD_ID=123456789012345678
TIMEZONE=America/New_York
SUNDAY_UPDATE_HOUR=12
UPDATE_DELAY_SECONDS=1.5

# Required on Railway: Tracker Network Cloudflare-blocks cloud IPs.
# Use a REAL residential proxy (not FlareSolverr, not example placeholders).
# Example formats:
#   TRACKER_PROXY=http://USERNAME:PASSWORD@HOST:PORT
#   TRACKER_PROXY=socks5://USERNAME:PASSWORD@HOST:PORT
TRACKER_PROXY=

# Optional:
# TRN_API_KEY=
# DATA_DIR=/data
# PEAK_ALL_TIME=0
