DISCORD_TOKEN=your_bot_token_here
ALLOWED_CHANNEL_ID=123456789012345678
GUILD_ID=123456789012345678
TIMEZONE=America/New_York
SUNDAY_UPDATE_HOUR=12
UPDATE_DELAY_SECONDS=1.5

# REQUIRED for reliable lookups on Railway (Cloudflare blocks the unofficial API from cloud IPs).
# 1) Go to https://tracker.gg/developers
# 2) Create an app
# 3) Copy the API key into this variable
TRN_API_KEY=your_tracker_network_api_key

# Optional local override; on Railway, attach a volume and use RAILWAY_VOLUME_MOUNT_PATH
# DATA_DIR=/data
# Optional fallback proxy if you still get blocked:
# TRACKER_PROXY=http://user:pass@host:port
