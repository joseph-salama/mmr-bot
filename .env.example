DISCORD_TOKEN=your_bot_token_here
ALLOWED_CHANNEL_ID=123456789012345678
GUILD_ID=123456789012345678
TIMEZONE=America/New_York
SUNDAY_UPDATE_HOUR=12
UPDATE_DELAY_SECONDS=1.5

# Free Cloudflare bypass for Railway (recommended):
# 1) Add a second Railway service from Docker image:
#    ghcr.io/flaresolverr/flaresolverr:latest
# 2) No public domain needed
# 3) Set this on the bot service (replace service name if different):
FLARESOLVERR_URL=http://flaresolverr.railway.internal:8191/v1

