DISCORD_TOKEN=your_bot_token_here
ALLOWED_CHANNEL_ID=123456789012345678
GUILD_ID=123456789012345678
TIMEZONE=America/New_York
SUNDAY_UPDATE_HOUR=12
UPDATE_DELAY_SECONDS=1.5

# Free Cloudflare bypass: FlareSolverr in the SAME Railway project.
# Do NOT hardcode flaresolverr.railway.internal — use Railway variable references.
# On the bot service Variables tab, add (click + Variable → insert via reference):
#   FLARESOLVERR_URL=http://${{flaresolverr.RAILWAY_PRIVATE_DOMAIN}}:${{flaresolverr.PORT}}/v1
# Replace "flaresolverr" with the EXACT service name shown on your Railway canvas.
#
# Alternative (public): give FlareSolverr a Railway domain, then:
#   FLARESOLVERR_URL=https://${{flaresolverr.RAILWAY_PUBLIC_DOMAIN}}/v1

# Optional:
# TRN_API_KEY=your_tracker_network_api_key
# DATA_DIR=/data
# PEAK_ALL_TIME=0
