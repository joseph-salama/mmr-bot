DISCORD_TOKEN=your_bot_token_here
ALLOWED_CHANNEL_ID=123456789012345678
GUILD_ID=123456789012345678
TIMEZONE=America/New_York
SUNDAY_UPDATE_HOUR=12
UPDATE_DELAY_SECONDS=1.5

# REQUIRED for Railway: Tracker Network Cloudflare-blocks cloud IPs.
# TRN_API_KEY alone is NOT enough for Rocket League from Railway.
# 1) Sign up free at https://www.scraperapi.com/
# 2) Copy your API key
# 3) Add it here / in Railway Variables
SCRAPER_API_KEY=your_scraperapi_key

# Optional alternatives:
# TRN_API_KEY=your_tracker_network_api_key
# ZENROWS_API_KEY=your_zenrows_key
# TRACKER_PROXY=http://user:pass@host:port
# DATA_DIR=/data
# PEAK_ALL_TIME=0
